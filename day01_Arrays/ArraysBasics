public class ArraysBasics {

    public static void main(String[] args) {

        int[] numbers = {10, 20, 30, 40, 50};

        System.out.println("First element: " + numbers[0]);
        System.out.println("Array length: " + numbers.length);

        System.out.println("Array elements:");

        for (int i = 0; i < numbers.length; i++) {
            System.out.println(numbers[i]);
        }
    }
}

        // Insertion
        int[] afterInsertion = new int[numbers.length + 1];
        int position = 2;
        int value = 25;

        for (int i = 0; i < position; i++) {
            afterInsertion[i] = numbers[i];
        }

        afterInsertion[position] = value;

        for (int i = position; i < numbers.length; i++) {
            afterInsertion[i + 1] = numbers[i];
        }

        System.out.println("After insertion:");

        for (int i = 0; i < afterInsertion.length; i++) {
            System.out.println(afterInsertion[i]);
